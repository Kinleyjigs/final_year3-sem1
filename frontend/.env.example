# Frontend Environment Variables

# API Gateway URL (change in production)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_NAME="One Stop Book"
NEXT_PUBLIC_APP_DESCRIPTION="Campus Ground Booking Platform"

# WorkOS Authentication
# Follow these steps to get your credentials:
# 1. Sign up at https://dashboard.workos.com/
# 2. Go to "API Keys" section
# 3. Copy your API Key (starts with sk_test_ or sk_live_)
# 4. Copy your Client ID (starts with client_)
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_CLIENT_ID=client_your_client_id_here
WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Generate a secure 32+ character password using:
# openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=generate-using-openssl-rand-base64-24

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_DEBUG=false
